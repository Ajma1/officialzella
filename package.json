{
  "name": "zella",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @zella/storefront-1",
    "build": "npm run build -w @zella/storefront-1",
