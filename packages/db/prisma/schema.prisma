generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductCategory {
  SHIRT
  TROUSER
  BUNDLE
}

enum Size {
  XS
  S
  M
  L
  XL
}

enum OrderStatus {
  PENDING
  CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
}

model Product {
  id          String          @id @default(cuid())
  /// Human-readable inventory code (e.g. "SH-PBS"), distinct from the
  /// cuid `id` and the URL `slug` — what admin/inventory screens reference.
  sku         String          @unique
  name        String
  slug        String          @unique
  description String
  priceCents  Int
  category    ProductCategory
  colorway    String?
  colorwaySwatch String       @default("#e8ded1")
  compareAtCents Int?
  active      Boolean         @default(true)
  images      ProductImage[]
  variants    ProductVariant[]
  orderItems  OrderItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ProductVariant {
  id        String  @id @default(cuid())
  size      Size
  stock     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([productId, size])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId])
}

model Address {
  id         String  @id @default(cuid())
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String
  order      Order?
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  totalCents    Int
  /// Total pair-bundle savings folded into totalCents — kept separately so
  /// receipts/admin can show "saved Rs X", not just the final total.
  discountCents Int           @default(0)
  customerName  String
  customerPhone String
  customerEmail String?
  /// Optional, +923xxxxxxxxx format — collected for delivery-coordination
  /// WhatsApp messages, separate from customerPhone (which may be a landline).
  customerWhatsapp String?
  notes         String?
  address       Address       @relation(fields: [addressId], references: [id])
  addressId     String        @unique
  items         OrderItem[]
  customer      Customer?     @relation(fields: [customerId], references: [id])
  customerId    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([customerId])
}

model Customer {
  id        String            @id @default(cuid())
  email     String            @unique
  name      String?
  createdAt DateTime          @default(now())
  orders    Order[]
  pins      LoginPin[]
  sessions  CustomerSession[]
}

model LoginPin {
  id         String    @id @default(cuid())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

model CustomerSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model OrderItem {
  id         String  @id @default(cuid())
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  product    Product @relation(fields: [productId], references: [id])
  productId  String
  size       Size
  quantity   Int
  priceCents Int
  /// Shared across the shirt+trouser rows of one "pair" purchase, purely
  /// for grouped display in order history/admin — pricing/discount lives
  /// on Order.discountCents, not per-line.
  pairGroupId String?

  @@index([orderId])
  @@index([productId])
}

enum FeedbackStatus {
  PENDING
  APPROVED
  REJECTED
}

model Feedback {
  id          String         @id @default(cuid())
  rating      Int            // 1–5, validated at the action layer
  name        String?
  /// Admin-only — never rendered on any public page.
  email       String?
  orderNumber String?
  message     String
  status      FeedbackStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
}
